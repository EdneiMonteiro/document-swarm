{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docswarm:presentation/deck.schema.json",
  "title": "DeckSpec",
  "description": "Authored presentation model. Every visible word belongs here; exporters compose it and never write new prose.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deck_id", "language", "title", "size_pt", "theme_ref", "index", "topics", "slides"],
  "properties": {
    "schema_version": {"const": 1},
    "deck_id": {"$ref": "#/$defs/id"},
    "language": {"enum": ["pt-BR", "pt-PT", "en-US", "en-GB", "es-ES"]},
    "title": {"$ref": "#/$defs/line"},
    "size_pt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "number", "minimum": 240, "maximum": 2880},
        "height": {"type": "number", "minimum": 180, "maximum": 2160}
      }
    },
    "theme_ref": {"$ref": "#/$defs/id"},
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {"title": {"$ref": "#/$defs/line"}}
    },
    "topics": {"type": "array", "minItems": 1, "maxItems": 200, "uniqueItems": true, "items": {"$ref": "#/$defs/topic_id"}},
    "assets": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/asset"}},
    "references": {"type": "array", "maxItems": 400, "items": {"$ref": "#/$defs/reference"}},
    "actions": {"type": "array", "maxItems": 400, "items": {"$ref": "#/$defs/action"}},
    "slides": {"type": "array", "minItems": 1, "maxItems": 300, "items": {"$ref": "#/$defs/slide"}},
    "supports": {"type": "array", "maxItems": 300, "items": {"$ref": "#/$defs/support"}}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "Authored identifier. The sys: namespace is reserved for generated pages and actions."
    },
    "topic_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
    "line": {"type": "string", "minLength": 1, "maxLength": 400},
    "inline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 4000},
        "bold": {"type": "boolean"},
        "italic": {"type": "boolean"},
        "code": {"type": "boolean"},
        "reference_id": {"$ref": "#/$defs/id"}
      }
    },
    "richtext": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/inline"}},
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runs"],
      "properties": {
        "runs": {"$ref": "#/$defs/richtext"},
        "marker": {"enum": ["bullet", "number"]},
        "level": {"type": "integer", "minimum": 0, "maximum": 2}
      }
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 2880},
        "y": {"type": "number", "minimum": 0, "maximum": 2160},
        "width": {"type": "number", "minimum": 1, "maximum": 2880},
        "height": {"type": "number", "minimum": 1, "maximum": 2160}
      }
    },
    "placement": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["area"], "properties": {"area": {"$ref": "#/$defs/id"}}},
        {"type": "object", "additionalProperties": false, "required": ["box"], "properties": {"box": {"$ref": "#/$defs/box"}}}
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "path", "media_type", "sha256", "license_ref", "permitted_uses"],
      "properties": {
        "asset_id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "minLength": 1, "maxLength": 240},
        "media_type": {"enum": ["image/png", "image/jpeg"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "license_ref": {"type": "string", "minLength": 1, "maxLength": 240},
        "permitted_uses": {
          "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
          "items": {"enum": ["render", "redistribute"]}
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_id", "title", "locator"],
      "properties": {
        "reference_id": {"$ref": "#/$defs/id"},
        "title": {"$ref": "#/$defs/line"},
        "url": {"type": "string", "pattern": "^https://[^\\s\"'<>]{3,500}$"},
        "locator": {"type": "string", "minLength": 1, "maxLength": 400}
      }
    },
    "action": {
      "type": "object",
      "required": ["action_id", "trigger_block_id", "kind"],
      "properties": {
        "action_id": {"$ref": "#/$defs/id"},
        "trigger_block_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["goto_slide", "open_support", "open_external"]},
        "slide_id": {"$ref": "#/$defs/id"},
        "support_id": {"$ref": "#/$defs/id"},
        "reference_id": {"$ref": "#/$defs/id"}
      },
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["slide_id"],
          "properties": {
            "action_id": {"$ref": "#/$defs/id"},
            "trigger_block_id": {"$ref": "#/$defs/id"},
            "slide_id": {"$ref": "#/$defs/id"},
            "kind": {"const": "goto_slide"}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["support_id"],
          "properties": {
            "action_id": {"$ref": "#/$defs/id"},
            "trigger_block_id": {"$ref": "#/$defs/id"},
            "support_id": {"$ref": "#/$defs/id"},
            "kind": {"const": "open_support"}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["reference_id"],
          "properties": {
            "action_id": {"$ref": "#/$defs/id"},
            "trigger_block_id": {"$ref": "#/$defs/id"},
            "reference_id": {"$ref": "#/$defs/id"},
            "kind": {"const": "open_external"}
          }
        }
      ]
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "type", "layout", "data"],
      "properties": {
        "block_id": {"$ref": "#/$defs/id"},
        "type": {"enum": ["text", "table", "code", "image", "shape", "diagram", "control"]},
        "layout": {"$ref": "#/$defs/placement"},
        "style_token": {"$ref": "#/$defs/id"},
        "reading_order": {"type": "integer", "minimum": 1, "maximum": 400},
        "name": {"$ref": "#/$defs/line"},
        "data": {"type": "object"}
      },
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "data"],
          "properties": {
            "type": {"const": "text"},
            "data": {
              "type": "object", "additionalProperties": false, "required": ["paragraphs"],
              "properties": {
                "paragraphs": {"type": "array", "minItems": 1, "maxItems": 60, "items": {"$ref": "#/$defs/paragraph"}}
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "data"],
          "properties": {
            "type": {"const": "table"},
            "data": {
              "type": "object", "additionalProperties": false, "required": ["header", "rows"],
              "properties": {
                "header": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/richtext"}},
                "rows": {
                  "type": "array", "minItems": 1, "maxItems": 60,
                  "items": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/richtext"}}
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "data"],
          "properties": {
            "type": {"const": "code"},
            "data": {
              "type": "object", "additionalProperties": false, "required": ["lines"],
              "properties": {
                "language": {"$ref": "#/$defs/id"},
                "lines": {"type": "array", "minItems": 1, "maxItems": 400, "items": {"type": "string", "maxLength": 400}}
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "data"],
          "properties": {
            "type": {"const": "image"},
            "data": {
              "type": "object", "additionalProperties": false, "required": ["asset_id", "alt"],
              "properties": {"asset_id": {"$ref": "#/$defs/id"}, "alt": {"$ref": "#/$defs/line"}}
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "data"],
          "properties": {
            "type": {"const": "shape"},
            "data": {
              "type": "object", "additionalProperties": false, "required": ["shape"],
              "properties": {
                "shape": {"enum": ["rect", "round-rect", "ellipse"]},
                "text": {"$ref": "#/$defs/richtext"}
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "data"],
          "properties": {
            "type": {"const": "diagram"},
            "data": {
              "type": "object", "additionalProperties": false, "required": ["nodes"],
              "properties": {
                "nodes": {
                  "type": "array", "minItems": 1, "maxItems": 40,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["node_id", "shape", "text", "box"],
                    "properties": {
                      "node_id": {"$ref": "#/$defs/id"},
                      "shape": {"enum": ["rect", "round-rect", "ellipse"]},
                      "text": {"$ref": "#/$defs/richtext"},
                      "box": {"$ref": "#/$defs/box"}
                    }
                  }
                },
                "connectors": {
                  "type": "array", "maxItems": 80,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["connector_id", "from", "to", "from_port", "to_port", "kind"],
                    "properties": {
                      "connector_id": {"$ref": "#/$defs/id"},
                      "from": {"$ref": "#/$defs/id"},
                      "to": {"$ref": "#/$defs/id"},
                      "from_port": {"enum": ["left", "right", "top", "bottom"]},
                      "to_port": {"enum": ["left", "right", "top", "bottom"]},
                      "kind": {"enum": ["straight", "elbow"]}
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "data"],
          "properties": {
            "type": {"const": "control"},
            "data": {
              "type": "object", "additionalProperties": false, "required": ["action_id", "label"],
              "properties": {"action_id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/line"}}
            }
          }
        }
      ]
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slide_id", "topic_ids", "layout", "title", "blocks", "presenter_notes"],
      "properties": {
        "slide_id": {"$ref": "#/$defs/id"},
        "topic_ids": {"type": "array", "minItems": 1, "maxItems": 40, "uniqueItems": true, "items": {"$ref": "#/$defs/topic_id"}},
        "layout": {"$ref": "#/$defs/id"},
        "title": {"$ref": "#/$defs/richtext"},
        "blocks": {"type": "array", "maxItems": 40, "items": {"$ref": "#/$defs/block"}},
        "presenter_notes": {"type": "string", "maxLength": 8000}
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support_id", "layout", "title", "blocks", "presenter_notes"],
      "properties": {
        "support_id": {"$ref": "#/$defs/id"},
        "layout": {"$ref": "#/$defs/id"},
        "title": {"$ref": "#/$defs/richtext"},
        "blocks": {"type": "array", "maxItems": 40, "items": {"$ref": "#/$defs/block"}},
        "presenter_notes": {"type": "string", "maxLength": 8000}
      }
    }
  }
}
