{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-v1 records",
  "$comment": "Relational, file/hash and full-document coverage constraints are enforced by evidence.py.",
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "text": {"type": "string", "minLength": 1},
    "artifact": {
      "type": "object", "required": ["path", "sha256"], "additionalProperties": false,
      "properties": {
        "path": {"$ref": "#/$defs/text"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "span": {
      "type": "object", "required": ["start", "end", "quote"],
      "properties": {
        "start": {"type": "integer", "minimum": 1},
        "end": {"type": "integer", "minimum": 1},
        "quote": {"$ref": "#/$defs/text"}
      }
    },
    "relation": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {
        "subject": {"$ref": "#/$defs/text"},
        "action": {"$ref": "#/$defs/text"},
        "object": {"$ref": "#/$defs/text"},
        "place": {"$ref": "#/$defs/text"},
        "time": {"$ref": "#/$defs/text"},
        "direction": {"$ref": "#/$defs/text"},
        "conditions": {"$ref": "#/$defs/text"},
        "result": {"$ref": "#/$defs/text"}
      }
    },
    "finding": {
      "type": "object",
      "required": ["id", "family", "severity", "reason", "action", "evidence", "family_inspection", "occurrences"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "family": {"$ref": "#/$defs/id"},
        "severity": {"enum": ["blocking", "minor"]},
        "reason": {"$ref": "#/$defs/text"},
        "action": {"$ref": "#/$defs/text"},
        "evidence": {"$ref": "#/$defs/text"},
        "family_inspection": {"$ref": "#/$defs/text"},
        "occurrences": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "inventory": {
      "type": "object", "required": ["schema_version", "candidate_id", "claims", "blocks"],
      "properties": {
        "schema_version": {"const": 1},
        "candidate_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "claims": {
          "type": "array",
          "items": {
            "type": "object", "required": ["id", "relation", "occurrences"],
            "properties": {
              "id": {"$ref": "#/$defs/id"}, "relation": {"$ref": "#/$defs/relation"},
              "occurrences": {
                "type": "array", "minItems": 1,
                "items": {"allOf": [
                  {"$ref": "#/$defs/span"},
                  {"type": "object", "required": ["id"], "properties": {"id": {"$ref": "#/$defs/id"}}}
                ]}
              }
            }
          }
        },
        "blocks": {
          "type": "array", "minItems": 1,
          "items": {"allOf": [
            {"$ref": "#/$defs/span"},
            {
              "type": "object", "required": ["id", "classification", "justification", "claims"],
              "properties": {
                "id": {"$ref": "#/$defs/id"},
                "classification": {"enum": ["factual", "non_factual", "assumption", "estimate", "interpretation"]},
                "justification": {"$ref": "#/$defs/text"},
                "claims": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
              }
            }
          ]}
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["schema_version", "evidence_contract", "candidate_id", "reviewer", "cycle", "scope", "justification", "evidence_findings"],
      "properties": {
        "schema_version": {"const": 1}, "evidence_contract": {"const": "evidence-v1"},
        "candidate_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reviewer": {"$ref": "#/$defs/id"},
        "cycle": {"type": "integer", "minimum": 1}, "scope": {"const": "full_document"},
        "justification": {"$ref": "#/$defs/text"},
        "evidence_findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "inventory_complete": {"type": "boolean"},
        "critical": {"type": "boolean"},
        "reviewed_reviewers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "review_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "paraphrase_check": {"$ref": "#/$defs/paraphrase_check"},
        "contest_rulings": {"type": "array", "items": {"$ref": "#/$defs/contest_ruling"}},
        "escalation_rulings": {"type": "array", "items": {"$ref": "#/$defs/escalation_ruling"}},
        "editorial": {
          "type": "object",
          "properties": {
            "blind_paraphrase": {"$ref": "#/$defs/blind_paraphrase"}
          }
        },
        "topics": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["topic", "grade", "justification", "action"],
            "properties": {
              "topic": {"$ref": "#/$defs/id"},
              "grade": {"enum": ["D-", "D", "D+", "C-", "C", "C+", "B-", "B", "B+", "A-", "A", "A+"]},
              "justification": {"$ref": "#/$defs/text"}, "action": {"type": "string"}
            }
          }
        },
        "block_checks": {
          "type": "array",
          "items": {
            "type": "object", "required": ["id", "accepted", "justification"],
            "properties": {
              "id": {"$ref": "#/$defs/id"}, "accepted": {"type": "boolean"},
              "justification": {"$ref": "#/$defs/text"}
            }
          }
        },
        "assessments": {
          "type": "array",
          "items": {
            "type": "object", "required": ["claim", "conclusion", "justification", "consistency", "occurrences", "evidence"],
            "properties": {
              "claim": {"$ref": "#/$defs/id"},
              "conclusion": {"enum": ["supported", "contradicted", "uncertain"]},
              "justification": {"$ref": "#/$defs/text"}, "consistency": {"$ref": "#/$defs/text"},
              "occurrences": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
              "evidence": {
                "type": "array", "minItems": 1,
                "items": {"allOf": [
                  {"$ref": "#/$defs/span"},
                  {"type": "object", "required": ["source"], "properties": {"source": {"$ref": "#/$defs/id"}}}
                ]}
              }
            }
          }
        }
      }
    },
    "blind_paraphrase": {
      "type": "object",
      "required": ["central_thesis", "how_parts_connect", "unconnected_sections"],
      "additionalProperties": false,
      "properties": {
        "reader_context": {"$ref": "#/$defs/artifact"},
        "central_thesis": {"type": "string", "minLength": 30, "maxLength": 2500},
        "how_parts_connect": {"type": "string", "minLength": 30, "maxLength": 2500},
        "unconnected_sections": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        }
      }
    },
    "paraphrase_check": {
      "type": "object",
      "required": ["reviewer", "brief_sha256", "matches_brief", "justification"],
      "additionalProperties": false,
      "properties": {
        "reviewer": {"$ref": "#/$defs/id"},
        "brief_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "matches_brief": {"type": "boolean"},
        "justification": {"type": "string", "minLength": 20, "maxLength": 3000}
      }
    },
    "citation": {
      "type": "object",
      "required": ["target", "start", "end", "quote"],
      "additionalProperties": false,
      "properties": {
        "target": {"$ref": "#/$defs/id"},
        "start": {"type": "integer", "minimum": 1},
        "end": {"type": "integer", "minimum": 1},
        "quote": {"$ref": "#/$defs/text"}
      }
    },
    "contest_ruling": {
      "type": "object",
      "required": ["finding", "target_reviewer", "verdict", "justification", "citations"],
      "additionalProperties": false,
      "properties": {
        "finding": {"$ref": "#/$defs/id"},
        "target_reviewer": {"$ref": "#/$defs/id"},
        "verdict": {"enum": ["upheld", "rejected"]},
        "justification": {"type": "string", "minLength": 20, "maxLength": 3000},
        "citations": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/citation"}},
        "overturned_topics": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "overturned_claims": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "overturned_blocks": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "escalation_ruling": {
      "type": "object",
      "required": ["finding", "target_reviewer", "verdict", "justification"],
      "additionalProperties": false,
      "properties": {
        "finding": {"$ref": "#/$defs/id"},
        "target_reviewer": {"$ref": "#/$defs/id"},
        "verdict": {"enum": ["accepted_out_of_band", "rejected"]},
        "justification": {"type": "string", "minLength": 20, "maxLength": 3000},
        "overturned_topics": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
